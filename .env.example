# Docker Compose 开发环境凭据。将本文件复制为 .env，
# 并在启动服务前替换所有 change-me 占位值。
POSTGRES_USER=pg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=graph_rag

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# 可选的实体关系图。GRAPH__ENABLED=true 后，索引 Worker 会抽取实体/关系，
# 检索 API 可选 graph 模式。应用与 Compose 使用同一 Neo4j 密码。
GRAPH__ENABLED=false
GRAPH__URI=bolt://localhost:7687
GRAPH__USERNAME=neo4j
GRAPH__PASSWORD=change-me
GRAPH__DATABASE=neo4j
GRAPH__EXTRACTION_BASE_URL=http://localhost:8001/v1
GRAPH__EXTRACTION_API_KEY=
GRAPH__EXTRACTION_MODEL=

# Optional local-model Compose overlay (docker-compose.local-models.yml).
# Point to the complete BAAI/bge-large-zh-v1.5 directory; it is mounted read-only.
LOCAL_EMBEDDING_MODEL_PATH=./data/models/bge-large-zh-v1.5
LOCAL_GRAPH_ENABLED=true
LOCAL_GRAPH_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_GRAPH_MODEL=graph-qwen2.5:1.5b

BROKER__HOST=localhost
BROKER__PORT=5672
BROKER__USERNAME=graph_rag
BROKER__PASSWORD=change-me
BROKER__VIRTUAL_HOST=graph_rag
PARSER__OCR_ENABLED=false
PARSER__OCR_DEVICE=cpu
PARSER__OCR_LANGUAGE=ch
# Leave empty for PaddleOCR's default cache; otherwise set the text detection model directory.
PARSER__OCR_MODEL_DIR=
PARSER__OCR_MIN_CONFIDENCE=0.5
PARSER__OCR_MAX_IMAGE_WIDTH=12000
PARSER__OCR_MAX_IMAGE_HEIGHT=12000
PARSER__OCR_MAX_IMAGE_PIXELS=40000000
PARSER__OCR_MAX_LINES_PER_DOCUMENT=20000
PARSER__OCR_PDF_RENDER_DPI=144
