# Docker Compose 开发环境凭据。将本文件复制为 .env，
# 并在启动服务前替换所有 change-me 占位值。
POSTGRES_USER=pg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=graph_rag

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# 可选的实体关系图。GRAPH__ENABLED=true 后，索引 Worker 会抽取实体/关系，
# 检索 API 可选 graph 模式。应用与 Compose 使用同一 Neo4j 密码。
GRAPH__ENABLED=false
GRAPH__URI=bolt://localhost:7687
GRAPH__USERNAME=neo4j
GRAPH__PASSWORD=change-me
GRAPH__DATABASE=neo4j
GRAPH__EXTRACTION_BASE_URL=http://localhost:8001/v1
GRAPH__EXTRACTION_API_KEY=
GRAPH__EXTRACTION_MODEL=

BROKER__HOST=localhost
BROKER__PORT=5672
BROKER__USERNAME=graph_rag
BROKER__PASSWORD=change-me
BROKER__VIRTUAL_HOST=graph_rag
